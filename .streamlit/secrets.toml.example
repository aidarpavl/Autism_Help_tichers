# Скопируйте в .streamlit/secrets.toml (локально) или вставьте в Settings → Secrets
# на Streamlit Community Cloud. Никогда не добавляйте настоящие ключи в репозиторий.

# ИИ. Без ключа приложение работает на встроенных методических шаблонах.
ANTHROPIC_API_KEY = ""
QADAM_MODEL = "claude-sonnet-5-5"

# Необязательно: код, без которого нельзя зарегистрироваться как учитель.
TEACHER_SIGNUP_CODE = ""

# Сохранение базы в ОТДЕЛЬНЫЙ ПРИВАТНЫЙ репозиторий GitHub.
# Без этого на Streamlit Cloud данные пропадут при перезапуске приложения.
# Токен: fine-grained, доступ только к этому репозитории, Contents: Read and write.
GITHUB_BACKUP_REPO = ""        # например: myname/qadam-data
GITHUB_BACKUP_TOKEN = ""
GITHUB_BACKUP_BRANCH = "main"
